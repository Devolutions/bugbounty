# The PostgreSQL BASE image that bb-dvls-sql-linux was built from, pinned in ONE place.
#
# Consumers must read this variable and fail loudly when it is unset. Do NOT add an inline default
# (`${POSTGRES_IMAGE:-postgres:17-alpine}`): a default is precisely how a second hardcoded copy
# creeps back, and it hides drift between this pin and the published image.
POSTGRES_IMAGE=postgres:17-alpine

# PostgreSQL cluster superuser. Not the DVLS credential - install.py regenerates this per
# install and nothing hunter-facing needs it.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=K-zzkSMTAR6yfiQR!.5.yFY%

# The role DVLS connects as. Created at restore time by the seed dump's prologue, which reads
# these two as DVLS_DB_USER / DVLS_DB_PASSWORD. Free to change: the role is created from
# these values on a fresh install, so an existing pgdata volume keeps the old ones.
DATABASE_NAME=dvls_docker
DATABASE_USERNAME=dvls_app
DATABASE_PASSWORD=WznHe2F5L3ltKYIt72_w_SAL

# The hunter login. UNLIKE DATABASE_USERNAME / DATABASE_PASSWORD, these CANNOT be changed per
# environment: the account is baked into the seed dump with its password hash, and nothing at
# restore or provisioning time rewrites it. Change these and dvls_seed fails to authenticate
# against the account it just restored. To change them for real, curate a new dump with the new
# values and republish the image. Leave these two exactly as they are.
DVLS_ADMIN_USERNAME=ADMINISTRATOR
DVLS_ADMIN_PASSWORD=SuperS3cure%5

# Written to AppSettings.AdditionalAccessUris by the seed provisioner. HTTPS only now: the
# container entrypoint serves a single WEB_SCHEME/WEB_PORT pair, so the old http://localhost:5580
# endpoint is gone.
DVLS_ACCESS_URIS='["https://localhost:5544/"]'

DVLS_ENCRYPTION_CONFIG_B64=""
GTW_HOSTNAME="gateway.loc"

